# Copia este archivo como .env y completa los valores.
# El servidor no arranca correctamente si falta alguna de estas variables.

# Cadena de conexion de MongoDB (Atlas o local)
URI_MONGODB =

# Secretos de firma de tokens JWT.
# Genera cada uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET =
REFRESH_TOKEN_SECRET =
ACTIVATION_TOKEN_SECRET =

# Configuracion de Resend para el envio de correos de verificacion.
# La API key se obtiene desde el panel de Resend.
RESEND_API_KEY =

# Direccion que aparecera como remitente de los correos.
# Durante las pruebas puede utilizarse el dominio de prueba de Resend.
RESEND_FROM_EMAIL = Tu App <onboarding@resend.dev>

# URL base del frontend. Se usa para armar el enlace de activacion del correo.
# En desarrollo es el puerto de Vite; en produccion, el dominio publicado.
CLIENT_URI = http://localhost:5173
